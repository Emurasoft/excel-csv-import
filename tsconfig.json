{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2023",
		"sourceMap": true,
		"declaration": false,
		"lib": ["dom", "es2023"],
		"jsx": "react",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
